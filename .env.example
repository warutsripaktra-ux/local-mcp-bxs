# ==============================
# Central machine: Secure MCP Tunnel
# ==============================
# Create at https://platform.openai.com/settings/organization/tunnels
CONTROL_PLANE_TUNNEL_ID=tunnel_replace_me
# Runtime key with Tunnels Read and Tunnels Use. Never commit this file as .env.
CONTROL_PLANE_API_KEY=sk_replace_me
# Optional when tunnel-client is not installed on PATH.
TUNNEL_CLIENT_BIN=/absolute/path/to/tunnel-client
# Optional tunnel-client profile name.
TUNNEL_PROFILE=futuremakers-gateway

# Central Router OAuth resource server. Use the exact issuer/resource values
# configured with the organization's established OIDC provider and ChatGPT.
OIDC_ISSUER=https://idp.example.com/
OIDC_AUDIENCE=https://mcp.example.com
# Optional test-only override; production derives jwks_uri from OIDC discovery.
# OIDC_DISCOVERY_URL=https://idp.example.com/.well-known/openid-configuration
# ROUTER_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# Public OIDC client used by `pnpm run agent` for PKCE login.
# OIDC_AGENT_CLIENT_ID=futuremakers-local-agent
# Authorization/token endpoints are discovered automatically from OIDC_ISSUER.
# OIDC_AUTHORIZATION_ENDPOINT=...
# OIDC_TOKEN_ENDPOINT=...

# Persistent Router state — choose the block for the central machine's OS.
# macOS (recommended for local development):
ROUTER_REGISTRY_FILE=/Users/your-user/.futuremakers-gateway/agents.json
ROUTER_CREDENTIAL_FILE=/Users/your-user/.futuremakers-gateway/credentials.json
# Linux (system/service deployment):
# ROUTER_REGISTRY_FILE=/var/lib/futuremakers-gateway/agents.json
# ROUTER_CREDENTIAL_FILE=/var/lib/futuremakers-gateway/credentials.json
ROUTER_MCP_PORT=8787

# ==============================
# User machine: local project agent
# ==============================
# URL of the central Router used by `pnpm run agent`.
# Local same-machine development:
ROUTER_AGENT_URL=http://localhost:8787
# Production/shared deployment example:
# ROUTER_AGENT_URL=https://mcp.your-company.com
# Whole-machine defaults (macOS/Linux). This exposes the entire machine.
PROJECT_ROOTS=/
ALLOW_READ=true
ALLOW_WRITE=true
ALLOW_PROCESS=true
# Comma-separated base commands allowed for process execution.
ALLOWED_COMMANDS=*
REQUIRE_CONFIRMATION_FOR=project:write,project:process

# Safer project-scoped alternative:
# PROJECT_ROOTS=/absolute/path/to/project
# ALLOW_READ=true
# ALLOW_WRITE=false
# ALLOW_PROCESS=false
# ALLOWED_COMMANDS=
# This is recommended for a shared Business App.

# Do not set these manually; scripts/run-agent.cjs creates them at runtime:
# DC_AGENT_POLICY=...
# DC_REMOTE_DEVICE=true

# User machines do not need per-user secrets in `.env`. `pnpm run agent`
# authenticates the user and stores its device credential in the OS keychain.
